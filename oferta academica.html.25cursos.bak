<section class="seccion-oferta">
    <div class="container text-center">
        <h2 class="titulo-oferta">Oferta Académica</h2>
        <p class="texto-oferta">Aprovecha la oportunidad de formarte con la excelencia de la URosario sin salir de tu
            zona. Consulta los programas de nuestra oferta, descarga el plan de estudios e inicia tu proceso de
            inscripción hoy mismo.</p>
        <p><a class="btn-inscripcion-general" href="#hubspot-form-section">Inscríbete a cualquiera de nuestros
                programas</a></p>
        <!-- Buscador -->
        <div class="buscador-oferta">
            <i class="fas fa-search icono-buscar"></i>
            <input type="text" id="buscadorCursos" placeholder="Buscar por nombre del programa...">
            <button class="btn-limpiar-busqueda" id="btnLimpiar" title="Limpiar búsqueda"><i
                    class="fas fa-times"></i></button>
        </div>
        <!-- Filtros -->
        <div class="filtros-oferta" id="filtrosOferta">
            <button class="chip-filtro activo" data-filtro="todos">Todos <span class="chip-count"
                    id="countTodos">20</span></button>
            <button class="chip-filtro" data-filtro="presencial"><i class="fas fa-building"></i> Presencial <span
                    class="chip-count" id="countPresencial">0</span></button>
            <button class="chip-filtro" data-filtro="remoto"><i class="fas fa-laptop-house"></i> Acceso remoto <span
                    class="chip-count" id="countRemoto">0</span></button>
        </div>
        <!-- Contador -->
        <div class="contador-resultados" id="contadorResultados">Mostrando <strong>20</strong> de <strong>20</strong>
            programas</div>
        <!-- Sin resultados -->
        <div class="sin-resultados" id="sinResultados"><i class="fas fa-search"></i>No se encontraron programas con ese
            criterio. Intenta con otra palabra clave.</div>
        <div class="contenedor-oferta">
